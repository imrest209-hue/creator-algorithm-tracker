# ---------------------------------------------------------------------------
# Creator Algorithm Tracker - environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required for accounts, real data, CSV import,
# and platform connections. The app runs fine WITHOUT this - it falls back to
# demo mode - but nothing signed-in works until this is set.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/creator_tracker?schema=public"

# Random secret used to sign/derive auxiliary tokens. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# AES-256-GCM key for encrypting OAuth tokens at rest. MUST decode (base64) to
# exactly 32 bytes. Generate with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY="replace-with-openssl-rand--base64-32-output"

# Public base URL of this deployment. Used to build OAuth callback URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- YouTube (Google Cloud Console) -----------------------------------------
# Create an OAuth 2.0 Client ID (Web application) with the YouTube Data API v3
# and YouTube Analytics API v2 enabled. Add this redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/connect/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Optional: a separate server-side API key (no OAuth) used only for the public
# "Trends" page (YouTube's public "most popular" chart). Leave blank to hide
# public trend data entirely - the app never fabricates it as a substitute.
YOUTUBE_API_KEY=""
TRENDS_REGION_CODE="US"

# --- TikTok (TikTok for Developers) -----------------------------------------
# Create a TikTok for Developers app with Login Kit and the video.list scope.
# Add this redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/connect/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- Twitch (dev.twitch.tv/console) -----------------------------------------
# Register an application, then add this redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/connect/twitch/callback
# Twitch's public API tracks clips (Get Clips) - view count only. Likes,
# comments, shares, retention, watch time and follower attribution are not
# exposed for clips and are recorded as unavailable, never estimated.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# --- Kick ---------------------------------------------------------------------
# No env vars: Kick has not published a public analytics API for clip/VOD
# performance yet, so there is no OAuth connection to configure. Kick is still
# fully trackable via CSV import or manual video entry - see Settings.

# --- Logging -----------------------------------------------------------------
# One of: debug | info | warn | error. Defaults to "debug" outside production.
LOG_LEVEL="info"
